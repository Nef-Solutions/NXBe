      "name": "Autenticación",
      "item": [
        {
          "name": "AUTH-01 Registrar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = String(10000000 + Math.floor(Math.random() * 8999999));",
                  "let sum = 0;",
                  "let multiplier = 2;",
                  "for (let index = base.length - 1; index >= 0; index -= 1) {",
                  "    sum += Number(base[index]) * multiplier;",
                  "    multiplier = multiplier === 7 ? 2 : multiplier + 1;",
                  "}",
                  "const remainder = 11 - (sum % 11);",
                  "const verifier = remainder === 11 ? '0' : (remainder === 10 ? 'K' : String(remainder));",
                  "pm.environment.set('test_email', `cliente.postman.${Date.now()}@ejemplo.cl`);",
                  "pm.environment.set('test_rut', `${base}-${verifier}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 - Registro exitoso\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Respuesta tiene campo id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Respuesta tiene campo email\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"email\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type es application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Pérez\",\n  \"phone\": \"+56912345678\",\n  \"rut\": \"{{test_rut}}\",\n  \"address\": \"Av. Principal 123\",\n  \"commune\": \"Santiago\",\n  \"role\": \"CLIENT\",\n  \"password\": \"ClaveSegura123!\",\n  \"privacy_policy_accepted\": true,\n  \"privacy_policy_version\": \"2026-10\"\n}",
